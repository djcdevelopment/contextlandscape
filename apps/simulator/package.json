{
  "name": "@landscape/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./attention-policies": "./dist/attention-policies.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "simulate": "tsx src/main.ts",
    "simulate:command": "node dist/command-main.js",
    "probe:attention-v4": "tsx src/attention-v4-probe-main.ts",
    "landscape:attention-v4": "tsx src/attention-v4-landscape-main.ts",
    "study:attention-v4:deep": "tsx src/attention-v4-deep-main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@landscape/contracts": "0.1.0",
    "@landscape/engine": "0.1.0",
    "@landscape/scenarios": "0.1.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
